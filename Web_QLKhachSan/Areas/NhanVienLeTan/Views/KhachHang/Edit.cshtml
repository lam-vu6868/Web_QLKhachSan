@model Web_QLKhachSan.Areas.NhanVienLeTan.ViewModels.KhachHang.KhachHangFormViewModel
@{
    ViewBag.Title = "Sửa Thông Tin Khách Hàng";
    Layout = "~/Areas/NhanVienLeTan/Views/Shared/_LayoutNVLT.cshtml";
}

@section styles {
    <link href="@Url.Content("~/Areas/NhanVienLeTan/assets/css/datPhong.css")" rel="stylesheet" />
}

<div class="container-fluid">
    @* ==== HEADER ==== *@
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-user-edit text-primary"></i> Sửa Thông Tin Khách Hàng
        </h1>
        <a href="@Url.Action("Index")" class="btn btn-secondary btn-icon-split shadow-sm">
            <span class="icon text-white-50">
                <i class="fas fa-arrow-left"></i>
            </span>
            <span class="text">Quay lại</span>
        </a>
    </div>

    @* ==== THÔNG BÁO ==== *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @* ==== FORM ==== *@
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-gradient-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-user"></i> Thông Tin Khách Hàng
                    </h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Edit", "KhachHang", FormMethod.Post, new { @class = "form-horizontal" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.MaKhachHang)
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.HoVaTen, new { @class = "font-weight-bold" })
                                    <span class="text-danger">*</span>
                                    @Html.TextBoxFor(m => m.HoVaTen, new { @class = "form-control", placeholder = "Nhập họ và tên" })
                                    @Html.ValidationMessageFor(m => m.HoVaTen, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.SoDienThoai, new { @class = "font-weight-bold" })
                                    <span class="text-danger">*</span>
                                    @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", placeholder = "0123456789", maxlength = "15" })
                                    @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Email, new { @class = "font-weight-bold" })
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "email@example.com" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.GioiTinh, new { @class = "font-weight-bold" })
                                    @Html.DropDownListFor(m => m.GioiTinh,
                                        new SelectList(new[]
                                        {
                                            new { Value = (byte?)null, Text = "-- Chọn giới tính --" },
                                            new { Value = (byte?)0, Text = "Nam" },
                                            new { Value = (byte?)1, Text = "Nữ" },
                                            new { Value = (byte?)2, Text = "Khác" }
                                        }, "Value", "Text", Model.GioiTinh),
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.GioiTinh, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.NgaySinh, new { @class = "font-weight-bold" })
                                    @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                    @Html.ValidationMessageFor(m => m.NgaySinh, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.AnhDaiDienUrl, new { @class = "font-weight-bold" })
                                    @Html.TextBoxFor(m => m.AnhDaiDienUrl, new { @class = "form-control", type = "url", placeholder = "https://example.com/image.jpg" })
                                    @Html.ValidationMessageFor(m => m.AnhDaiDienUrl, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.DiaChi, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", placeholder = "Nhập địa chỉ" })
                            @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "text-danger small" })
                        </div>

                        <hr />

                        <h5 class="mb-3"><i class="fas fa-key"></i> Tài Khoản</h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.TenDangNhap, new { @class = "font-weight-bold" })
                                    @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", placeholder = "Nhập tên đăng nhập" })
                                    @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> <strong>Lưu ý:</strong> Chỉ nhập mật khẩu nếu muốn thay đổi. Nếu để trống, mật khẩu sẽ giữ nguyên.
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.MatKhau, new { @class = "font-weight-bold" })
                                    @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Nhập mật khẩu mới (nếu muốn đổi)" })
                                    @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.XacNhanMatKhau, new { @class = "font-weight-bold" })
                                    @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control", placeholder = "Xác nhận mật khẩu mới" })
                                    @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save"></i> Cập Nhật
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times"></i> Hủy
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function() {
            // Chỉ validate mật khẩu nếu có nhập
            $('form').on('submit', function() {
                var matKhau = $('#MatKhau').val();
                var xacNhanMatKhau = $('#XacNhanMatKhau').val();
                
                if (matKhau || xacNhanMatKhau) {
                    if (matKhau !== xacNhanMatKhau) {
                        alert('Mật khẩu xác nhận không khớp!');
                        return false;
                    }
                    if (matKhau.length < 6) {
                        alert('Mật khẩu phải có ít nhất 6 ký tự!');
                        return false;
                    }
                }
            });
        });
    </script>
}

