@model Web_QLKhachSan.Areas.NhanVienLeTan.ViewModels.KhachHang.KhachHangFormViewModel
@{
    ViewBag.Title = "Thêm Khách Hàng Mới";
    Layout = "~/Areas/NhanVienLeTan/Views/Shared/_LayoutNVLT.cshtml";
}

@section styles {
    <link href="@Url.Content("~/Areas/NhanVienLeTan/assets/css/datPhong.css")" rel="stylesheet" />
}

<div class="container-fluid">
    @* ==== HEADER ==== *@
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-user-plus text-primary"></i> Thêm Khách Hàng Mới
        </h1>
        <a href="@Url.Action("Index")" class="btn btn-secondary btn-icon-split shadow-sm">
            <span class="icon text-white-50">
                <i class="fas fa-arrow-left"></i>
            </span>
            <span class="text">Quay lại</span>
        </a>
    </div>

    @* ==== THÔNG BÁO ==== *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @* ==== FORM ==== *@
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-gradient-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-user"></i> Thông Tin Khách Hàng
                    </h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Create", "KhachHang", FormMethod.Post, new { @class = "form-horizontal", id = "formCreateKhachHang" }))
                    {
                        @Html.AntiForgeryToken()
                        
                        @* Hiển thị lỗi tổng hợp - chỉ hiển thị khi có lỗi validation *@
                        if (!ViewData.ModelState.IsValid)
                        {
                            var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).ToList();
                            if (errors.Any())
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <h6 class="alert-heading mb-2">
                                        <i class="fas fa-exclamation-triangle"></i> Vui lòng sửa các lỗi sau:
                                    </h6>
                                    <ul class="mb-0 pl-3" style="list-style-type: disc;">
                                        @foreach (var error in errors)
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    </ul>
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                            }
                        }
                        
                        @* Hiển thị TempData ErrorMessage chỉ khi không có validation errors *@
                        if (TempData["ErrorMessage"] != null && ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.HoVaTen, new { @class = "font-weight-bold" })
                                    <span class="text-danger">*</span>
                                    @Html.TextBoxFor(m => m.HoVaTen, new { @class = "form-control", placeholder = "Nhập họ và tên" })
                                    @Html.ValidationMessageFor(m => m.HoVaTen, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.SoDienThoai, new { @class = "font-weight-bold" })
                                    <span class="text-danger">*</span>
                                    @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", placeholder = "0123456789", maxlength = "15" })
                                    @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Email, new { @class = "font-weight-bold" })
                                    <span id="emailRequired" class="text-danger" style="display: none;">*</span>
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "email@example.com", id = "txtEmail" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                                    <small class="form-text text-muted" id="emailHint">Email (bắt buộc nếu tạo tài khoản)</small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.GioiTinh, new { @class = "font-weight-bold" })
                                    @Html.DropDownListFor(m => m.GioiTinh,
                                        new SelectList(new[]
                                        {
                                            new { Value = (byte?)null, Text = "-- Chọn giới tính --" },
                                            new { Value = (byte?)0, Text = "Nam" },
                                            new { Value = (byte?)1, Text = "Nữ" },
                                            new { Value = (byte?)2, Text = "Khác" }
                                        }, "Value", "Text", Model.GioiTinh),
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.GioiTinh, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.NgaySinh, new { @class = "font-weight-bold" })
                                    @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                    @Html.ValidationMessageFor(m => m.NgaySinh, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.AnhDaiDienUrl, new { @class = "font-weight-bold" })
                                    @Html.TextBoxFor(m => m.AnhDaiDienUrl, new { @class = "form-control", type = "url", placeholder = "https://example.com/image.jpg" })
                                    @Html.ValidationMessageFor(m => m.AnhDaiDienUrl, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.DiaChi, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", placeholder = "Nhập địa chỉ" })
                            @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "text-danger small" })
                        </div>

                        <hr />

                        <div class="card bg-light mb-3">
                            <div class="card-body">
                                <h5 class="mb-3">
                                    <i class="fas fa-key text-primary"></i> Tài Khoản (Tùy chọn)
                                </h5>
                                <div class="alert alert-info mb-3">
                                    <i class="fas fa-info-circle"></i> <strong>Lưu ý:</strong> Nếu bạn nhập <strong>Tên đăng nhập</strong>, thì <strong>Email</strong> và <strong>Mật khẩu</strong> sẽ trở thành bắt buộc. Nếu không nhập tên đăng nhập, khách hàng sẽ không có tài khoản.
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.TenDangNhap, new { @class = "font-weight-bold" })
                                            @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", placeholder = "Nhập tên đăng nhập (tùy chọn)", id = "txtTenDangNhap" })
                                            @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger small" })
                                            <small class="form-text text-muted">Để trống nếu không muốn tạo tài khoản cho khách hàng</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="row" id="passwordSection">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.MatKhau, new { @class = "font-weight-bold" })
                                            <span id="matKhauRequired" class="text-danger" style="display: none;">*</span>
                                            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Nhập mật khẩu (tối thiểu 6 ký tự)", id = "txtMatKhau" })
                                            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger small" })
                                            <small class="form-text text-muted" id="matKhauHint">Mật khẩu (bắt buộc nếu tạo tài khoản)</small>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.XacNhanMatKhau, new { @class = "font-weight-bold" })
                                            <span id="xacNhanMatKhauRequired" class="text-danger" style="display: none;">*</span>
                                            @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control", placeholder = "Xác nhận mật khẩu", id = "txtXacNhanMatKhau" })
                                            @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger small" })
                                            <small class="form-text text-muted" id="xacNhanMatKhauHint">Xác nhận mật khẩu (bắt buộc nếu tạo tài khoản)</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save"></i> Lưu Khách Hàng
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times"></i> Hủy
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function() {
            // Kiểm tra khi nhập tên đăng nhập
            $('#txtTenDangNhap').on('input', function() {
                var tenDangNhap = $(this).val().trim();
                var hasTenDangNhap = tenDangNhap.length > 0;
                
                // Hiển thị/ẩn dấu * bắt buộc
                if (hasTenDangNhap) {
                    $('#emailRequired').show();
                    $('#matKhauRequired').show();
                    $('#xacNhanMatKhauRequired').show();
                    $('#emailHint').html('<span class="text-danger">Email <strong>(Bắt buộc khi tạo tài khoản)</strong></span>');
                    $('#matKhauHint').html('<span class="text-danger">Mật khẩu <strong>(Bắt buộc khi tạo tài khoản)</strong></span>');
                    $('#xacNhanMatKhauHint').html('<span class="text-danger">Xác nhận mật khẩu <strong>(Bắt buộc khi tạo tài khoản)</strong></span>');
                    
                    // Thêm required attribute
                    $('#txtEmail').attr('required', 'required');
                    $('#txtMatKhau').attr('required', 'required');
                    $('#txtXacNhanMatKhau').attr('required', 'required');
                } else {
                    $('#emailRequired').hide();
                    $('#matKhauRequired').hide();
                    $('#xacNhanMatKhauRequired').hide();
                    $('#emailHint').html('Email (bắt buộc nếu tạo tài khoản)');
                    $('#matKhauHint').html('Mật khẩu (bắt buộc nếu tạo tài khoản)');
                    $('#xacNhanMatKhauHint').html('Xác nhận mật khẩu (bắt buộc nếu tạo tài khoản)');
                    
                    // Xóa required attribute
                    $('#txtEmail').removeAttr('required');
                    $('#txtMatKhau').removeAttr('required');
                    $('#txtXacNhanMatKhau').removeAttr('required');
                }
            });

            // Validate form trước khi submit
            $('#formCreateKhachHang').on('submit', function(e) {
                var tenDangNhap = $('#txtTenDangNhap').val().trim();
                var email = $('#txtEmail').val().trim();
                var matKhau = $('#txtMatKhau').val();
                var xacNhanMatKhau = $('#txtXacNhanMatKhau').val();
                
                // Nếu có tên đăng nhập thì phải có email và mật khẩu
                if (tenDangNhap.length > 0) {
                    if (email.length === 0) {
                        alert('Vui lòng nhập Email! (Bắt buộc khi tạo tài khoản)');
                        $('#txtEmail').focus();
                        e.preventDefault();
                        return false;
                    }
                    if (matKhau.length === 0) {
                        alert('Vui lòng nhập Mật khẩu! (Bắt buộc khi tạo tài khoản)');
                        $('#txtMatKhau').focus();
                        e.preventDefault();
                        return false;
                    }
                    if (matKhau.length < 6) {
                        alert('Mật khẩu phải có ít nhất 6 ký tự!');
                        $('#txtMatKhau').focus();
                        e.preventDefault();
                        return false;
                    }
                    if (xacNhanMatKhau.length === 0) {
                        alert('Vui lòng xác nhận Mật khẩu! (Bắt buộc khi tạo tài khoản)');
                        $('#txtXacNhanMatKhau').focus();
                        e.preventDefault();
                        return false;
                    }
                    if (matKhau !== xacNhanMatKhau) {
                        alert('Mật khẩu xác nhận không khớp!');
                        $('#txtXacNhanMatKhau').focus();
                        e.preventDefault();
                        return false;
                    }
                }
            });

            // Trigger khi page load để kiểm tra giá trị ban đầu
            $('#txtTenDangNhap').trigger('input');
        });
    </script>
}

