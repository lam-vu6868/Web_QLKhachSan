@model Web_QLKhachSan.Areas.NhanVienLeTan.ViewModels.KhuyenMai.KhuyenMaiFormViewModel
@{
 ViewBag.Title = "Sửa Khuyến Mãi";
 Layout = "~/Areas/NhanVienLeTan/Views/Shared/_LayoutNVLT.cshtml";
}

@section styles {
 <link href="@Url.Content("~/Areas/NhanVienLeTan/assets/css/khuyenMai.css")" rel="stylesheet" />
}

<div class="container-fluid">
 <div class="d-sm-flex align-items-center justify-content-between mb-4">
 <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-edit"></i> Sửa Khuyến Mãi</h1>
 <a href="@Url.Action("Index", "KhuyenMai")" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
 </div>

 @using (Html.BeginForm("Edit", "KhuyenMai", FormMethod.Post, new { @class = "form-horizontal" }))
 {
 @Html.AntiForgeryToken()
 @Html.HiddenFor(m => m.KhuyenMaiId)

 <div class="card shadow mb-4">
 <div class="card-body">
 @Html.ValidationSummary(true, "", new { @class = "text-danger" })

 <div class="form-row">
 <div class="form-group col-md-6">
 @Html.LabelFor(m => m.MaKhuyenMai, new { @class = "font-weight-bold" })
 @Html.TextBoxFor(m => m.MaKhuyenMai, new { @class = "form-control", @readonly = "readonly" })
 <small class="form-text text-muted">Mã tự động, không thể sửa.</small>
 </div>
 <div class="form-group col-md-6">
 @Html.LabelFor(m => m.TenKhuyenMai, new { @class = "font-weight-bold" })
 @Html.TextBoxFor(m => m.TenKhuyenMai, new { @class = "form-control" })
 @Html.ValidationMessageFor(m => m.TenKhuyenMai, "", new { @class = "text-danger" })
 </div>
 </div>

 <div class="form-row">
 <div class="form-group col-md-4">
 @Html.LabelFor(m => m.GiaTri, new { @class = "font-weight-bold" })
 @Html.TextBoxFor(m => m.GiaTri, new { @class = "form-control", type = "number", step = "0.01", min = "0", max = "100" })
 @Html.ValidationMessageFor(m => m.GiaTri, "", new { @class = "text-danger" })
 </div>
 <div class="form-group col-md-4">
 @Html.LabelFor(m => m.NgayBatDau, new { @class = "font-weight-bold" })
 @Html.TextBoxFor(m => m.NgayBatDau, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
 @Html.ValidationMessageFor(m => m.NgayBatDau, "", new { @class = "text-danger" })
 </div>
 <div class="form-group col-md-4">
 @Html.LabelFor(m => m.NgayKetThuc, new { @class = "font-weight-bold" })
 @Html.TextBoxFor(m => m.NgayKetThuc, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
 @Html.ValidationMessageFor(m => m.NgayKetThuc, "", new { @class = "text-danger" })
 </div>
 </div>

 <div class="form-row">
 <div class="form-group col-md-8">
 @Html.LabelFor(m => m.DieuKienApDung, new { @class = "font-weight-bold" })
 @Html.TextAreaFor(m => m.DieuKienApDung,4,80, new { @class = "form-control" })
 @Html.ValidationMessageFor(m => m.DieuKienApDung, "", new { @class = "text-danger" })
 </div>
 <div class="form-group col-md-4">
 @Html.LabelFor(m => m.SoLanSuDungToiDa, new { @class = "font-weight-bold" })
 @Html.TextBoxFor(m => m.SoLanSuDungToiDa, new { @class = "form-control", type = "number", min = "0" })
 @Html.ValidationMessageFor(m => m.SoLanSuDungToiDa, "", new { @class = "text-danger" })

 <div class="form-check mt-3">
 @Html.CheckBoxFor(m => m.DaHoatDong, new { @class = "form-check-input", id = "DaHoatDong" })
 <label class="form-check-label" for="DaHoatDong">Đang hoạt động</label>
 </div>
 </div>
 </div>

 </div>
 <div class="card-footer text-right">
 <button type="submit" class="btn btn-primary">
 <i class="fas fa-save"></i> Lưu thay đổi
 </button>
 <a href="@Url.Action("Index", "KhuyenMai")" class="btn btn-secondary">
 <i class="fas fa-times"></i> Hủy
 </a>
 </div>
 </div>
 }
</div>

@section Scripts {
 <script>
 $(function() {
 // Client-side enhancements if needed
 });
 </script>
}
