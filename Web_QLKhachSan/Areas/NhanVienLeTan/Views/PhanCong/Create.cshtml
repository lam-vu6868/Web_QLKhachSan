@model Web_QLKhachSan.Areas.NhanVienLeTan.ViewModels.PhanCong.PhanCongFormViewModel
@{
    ViewBag.Title = "Phân Công Công Việc Mới";
    Layout = "~/Areas/NhanVienLeTan/Views/Shared/_LayoutNVLT.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-tasks text-primary"></i> Phân Công Công Việc Mới
        </h1>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-clipboard-list"></i> Thông Tin Phân Công</h5>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Create", "PhanCong", FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid)
                {
                    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).ToList();
                    if (errors.Any())
                    {
                        <div class="alert alert-danger">
                            <strong><i class="fas fa-exclamation-triangle"></i> Vui lòng sửa các lỗi sau:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var error in errors)
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }
                }

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.PhongId, new { @class = "font-weight-bold" })
                            <span class="text-danger">*</span>
                            @Html.DropDownListFor(m => m.PhongId, Model.DanhSachPhong, "-- Chọn phòng --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PhongId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.NhanVienBuongPhongId, new { @class = "font-weight-bold" })
                            <span class="text-danger">*</span>
                            @Html.DropDownListFor(m => m.NhanVienBuongPhongId, Model.DanhSachNhanVienBuongPhong, "-- Chọn nhân viên --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.NhanVienBuongPhongId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.MucDoUuTien, new { @class = "font-weight-bold" })
                            @Html.DropDownListFor(m => m.MucDoUuTien,
                                new SelectList(new[]
                                {
                                    new { Value = (byte)1, Text = "Thường" },
                                    new { Value = (byte)2, Text = "Cao" },
                                    new { Value = (byte)3, Text = "Khẩn cấp" }
                                }, "Value", "Text", Model.MucDoUuTien),
                                new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.ThoiGianDuKien, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.ThoiGianDuKien, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local", id = "txtThoiGianDuKien" })
                            @Html.ValidationMessageFor(m => m.ThoiGianDuKien, "", new { @class = "text-danger small" })
                            <small class="form-text text-muted">Thời gian dự kiến hoàn thành (tùy chọn, không được quá 30 phút trong quá khứ)</small>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.GhiChu, new { @class = "font-weight-bold" })
                    @Html.TextAreaFor(m => m.GhiChu, new { @class = "form-control", rows = 3 })
                    @Html.ValidationMessageFor(m => m.GhiChu, "", new { @class = "text-danger" })
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu Phân Công
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function() {
            // Validation thời gian dự kiến hoàn thành
            $('#txtThoiGianDuKien').on('change blur', function() {
                var selectedDateTime = new Date($(this).val());
                var now = new Date();
                var minDateTime = new Date(now.getTime() - 30 * 60 * 1000); // 30 phút trước
                var maxDateTime = new Date(now.getFullYear() + 1, now.getMonth(), now.getDate());

                if ($(this).val()) {
                    if (selectedDateTime < minDateTime) {
                        $(this).addClass('is-invalid');
                        var errorMsg = $('<span class="text-danger small">Thời gian dự kiến không được quá 30 phút trong quá khứ!</span>');
                        $(this).next('.text-danger').remove();
                        $(this).after(errorMsg);
                    } else if (selectedDateTime > maxDateTime) {
                        $(this).addClass('is-invalid');
                        var errorMsg = $('<span class="text-danger small">Thời gian dự kiến không được quá 1 năm trong tương lai!</span>');
                        $(this).next('.text-danger').remove();
                        $(this).after(errorMsg);
                    } else {
                        $(this).removeClass('is-invalid');
                        $(this).next('.text-danger').remove();
                    }
                } else {
                    $(this).removeClass('is-invalid');
                    $(this).next('.text-danger').remove();
                }
            });

            // Validate form trước khi submit
            $('form').on('submit', function(e) {
                var isValid = true;
                var thoiGianDuKien = $('#txtThoiGianDuKien').val();

                if (thoiGianDuKien) {
                    var selectedDateTime = new Date(thoiGianDuKien);
                    var now = new Date();
                    var minDateTime = new Date(now.getTime() - 30 * 60 * 1000);
                    var maxDateTime = new Date(now.getFullYear() + 1, now.getMonth(), now.getDate());

                    if (selectedDateTime < minDateTime || selectedDateTime > maxDateTime) {
                        isValid = false;
                        $('#txtThoiGianDuKien').trigger('blur');
                    }
                }

                if (!isValid) {
                    e.preventDefault();
                    $('html, body').animate({
                        scrollTop: $('#txtThoiGianDuKien').offset().top - 100
                    }, 500);
                }
            });
        });
    </script>
}

