@model Web_QLKhachSan.Areas.NhanVienBuongPhong.ViewModels.CongViec.CongViecListViewModel
@{
    ViewBag.Title = "Danh Sách Công Việc";
    Layout = "~/Areas/NhanVienBuongPhong/Views/Shared/_LayoutNVBP.cshtml";
}

@section styles {
    <style>
        /* Đảm bảo các form-group trong bộ lọc có chiều cao đồng đều */
        .card-body .form-group {
            min-height: 70px;
        }
        
        /* Responsive cho bộ lọc */
        @@media (max-width: 991px) {
            .card-body .form-group {
                min-height: auto;
            }
        }
        
        /* Đảm bảo các nút bấm có kích thước đồng đều */
        .card-body .btn {
            min-width: 120px;
        }
        
        @@media (max-width: 767px) {
            .card-body .btn {
                min-width: 100%;
                margin-bottom: 0.5rem;
            }
        }

        /* Highlight công việc quá hạn */
        .table-warning {
            background-color: #fff3cd !important;
        }

        /* Badge nhỏ hơn */
        .badge-sm {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
        }
    </style>
}

<div class="container-fluid">
    @* ==== HEADER ==== *@
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-tasks text-primary"></i> Danh Sách Công Việc
        </h1>
        <div>
            <span class="badge badge-info mr-2">
                <i class="fas fa-user"></i> Công việc của tôi
            </span>
        </div>
    </div>

    @* ==== THÔNG BÁO ==== *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @* ==== BỘ LỌC ==== *@
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-filter"></i> Bộ Lọc
            </h6>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Index", "CongViec", FormMethod.Get, new { @class = "form-horizontal" }))
            {
                <div class="row align-items-end">
                    <div class="col-lg-4 col-md-6 mb-3 mb-md-0">
                        <div class="form-group mb-0">
                            @Html.LabelFor(m => m.Filter.TimKiem, new { @class = "font-weight-bold mb-1" })
                            @Html.TextBoxFor(m => m.Filter.TimKiem, new { @class = "form-control", placeholder = "Mã phân công, phòng, ghi chú..." })
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6 mb-3 mb-md-0">
                        <div class="form-group mb-0">
                            @Html.LabelFor(m => m.Filter.TrangThaiCongViec, new { @class = "font-weight-bold mb-1" })
                            @Html.DropDownListFor(m => m.Filter.TrangThaiCongViec,
                                new SelectList(new[]
                                {
                                    new { Value = (byte?)null, Text = "-- Tất cả --" },
                                    new { Value = (byte?)0, Text = "Chờ xử lý" },
                                    new { Value = (byte?)1, Text = "Đang làm" },
                                    new { Value = (byte?)2, Text = "Hoàn thành" },
                                    new { Value = (byte?)3, Text = "Hủy" }
                                }, "Value", "Text", Model.Filter.TrangThaiCongViec),
                                new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6 mb-3 mb-md-0">
                        <div class="form-group mb-0">
                            @Html.LabelFor(m => m.Filter.MucDoUuTien, new { @class = "font-weight-bold mb-1" })
                            @Html.DropDownListFor(m => m.Filter.MucDoUuTien,
                                new SelectList(new[]
                                {
                                    new { Value = (byte?)null, Text = "-- Tất cả --" },
                                    new { Value = (byte?)1, Text = "Thường" },
                                    new { Value = (byte?)2, Text = "Cao" },
                                    new { Value = (byte?)3, Text = "Khẩn cấp" }
                                }, "Value", "Text", Model.Filter.MucDoUuTien),
                                new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-12">
                        <div class="form-group mb-0">
                            <label class="font-weight-bold mb-1 d-block" style="visibility: hidden;">Actions</label>
                            <div class="d-flex">
                                <button type="submit" class="btn btn-primary mr-2 flex-fill flex-md-grow-0">
                                    <i class="fas fa-search"></i> Tìm Kiếm
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-secondary flex-fill flex-md-grow-0">
                                    <i class="fas fa-redo"></i> Làm Mới
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ==== DANH SÁCH CÔNG VIỆC ==== *@
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-list"></i> Danh sách công việc
                <span class="badge badge-primary ml-2">@Model.TotalRecords công việc</span>
            </h6>
        </div>
        <div class="card-body">
            @if (Model.DanhSachCongViec != null && Model.DanhSachCongViec.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                        <thead class="thead-light">
                            <tr>
                                <th>Mã phân công</th>
                                <th>Phòng</th>
                                <th>Trạng thái</th>
                                <th>Mức độ ưu tiên</th>
                                <th>Thời gian phân công</th>
                                <th>Thời gian dự kiến</th>
                                <th>Thời gian hoàn thành</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DanhSachCongViec)
                            {
                                <tr class="@(item.QuaHan && item.TrangThaiCongViec != 2 ? "table-warning" : "")">
                                    <td>
                                        <strong>@item.MaPhanCong</strong>
                                    </td>
                                    <td>
                                        <strong>@item.MaPhong</strong>
                                        @if (item.Tang.HasValue)
                                        {
                                            <br /><small class="text-muted">Tầng @item.Tang</small>
                                        }
                                        <br /><small class="text-muted">@item.TenPhong</small>
                                    </td>
                                    <td>
                                        <span class="badge @item.TrangThaiBadgeClass">@item.TrangThaiText</span>
                                    </td>
                                    <td>
                                        <span class="badge @item.MucDoUuTienBadgeClass">@item.MucDoUuTienText</span>
                                    </td>
                                    <td>
                                        <small>@item.ThoiGianPhanCong.ToString("dd/MM/yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        @if (item.ThoiGianDuKien.HasValue)
                                        {
                                            <small class="@(item.QuaHan && item.TrangThaiCongViec != 2 ? "text-danger font-weight-bold" : "text-info")">
                                                <i class="fas fa-clock"></i> @item.ThoiGianDuKien.Value.ToString("dd/MM/yyyy HH:mm")
                                                @if (item.QuaHan && item.TrangThaiCongViec != 2)
                                                {
                                                    <br /><span class="badge badge-danger badge-sm">Quá hạn</span>
                                                }
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ThoiGianHoanThanh.HasValue)
                                        {
                                            <small class="text-success">@item.ThoiGianHoanThanh.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center" style="min-width: 180px;">
                                        <div class="btn-group-vertical btn-group-sm" role="group">
                                            <a href="@Url.Action("Details", new { id = item.PhanCongId })" 
                                               class="btn btn-sm btn-info mb-1" 
                                               title="Xem chi tiết">
                                                <i class="fas fa-eye"></i> Chi tiết
                                            </a>
                                            @if (item.CoTheBatDau)
                                            {
                                                <button type="button" class="btn btn-sm btn-success w-100 mb-1" 
                                                        title="Bắt đầu công việc"
                                                        data-toggle="modal" 
                                                        data-target="#confirmBatDauModal"
                                                        data-phancong-id="@item.PhanCongId"
                                                        data-phancong-ma="@item.MaPhanCong"
                                                        data-phong-ma="@item.MaPhong">
                                                    <i class="fas fa-play"></i> Bắt đầu
                                                </button>
                                            }
                                            @if (item.CoTheHoanThanh)
                                            {
                                                <button type="button" class="btn btn-sm btn-primary w-100 mb-1" 
                                                        title="Hoàn thành công việc"
                                                        data-toggle="modal" 
                                                        data-target="#confirmHoanThanhModal"
                                                        data-phancong-id="@item.PhanCongId"
                                                        data-phancong-ma="@item.MaPhanCong"
                                                        data-phong-ma="@item.MaPhong">
                                                    <i class="fas fa-check"></i> Hoàn thành
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* ==== PAGINATION ==== *@
                if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" href="@Url.Action("Index", new { 
                                    TimKiem = Model.Filter.TimKiem,
                                    TrangThaiCongViec = Model.Filter.TrangThaiCongViec,
                                    MucDoUuTien = Model.Filter.MucDoUuTien,
                                    TuNgayPhanCong = Model.Filter.TuNgayPhanCong?.ToString("yyyy-MM-dd"),
                                    DenNgayPhanCong = Model.Filter.DenNgayPhanCong?.ToString("yyyy-MM-dd"),
                                    CurrentPage = Model.CurrentPage - 1 
                                })">
                                    <i class="fas fa-chevron-left"></i> Trước
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        TimKiem = Model.Filter.TimKiem,
                                        TrangThaiCongViec = Model.Filter.TrangThaiCongViec,
                                        MucDoUuTien = Model.Filter.MucDoUuTien,
                                        TuNgayPhanCong = Model.Filter.TuNgayPhanCong?.ToString("yyyy-MM-dd"),
                                        DenNgayPhanCong = Model.Filter.DenNgayPhanCong?.ToString("yyyy-MM-dd"),
                                        CurrentPage = i 
                                    })">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" href="@Url.Action("Index", new { 
                                    TimKiem = Model.Filter.TimKiem,
                                    TrangThaiCongViec = Model.Filter.TrangThaiCongViec,
                                    MucDoUuTien = Model.Filter.MucDoUuTien,
                                    TuNgayPhanCong = Model.Filter.TuNgayPhanCong?.ToString("yyyy-MM-dd"),
                                    DenNgayPhanCong = Model.Filter.DenNgayPhanCong?.ToString("yyyy-MM-dd"),
                                    CurrentPage = Model.CurrentPage + 1 
                                })">
                                    Sau <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>

                    <p class="text-center text-muted">
                        Trang @Model.CurrentPage / @Model.TotalPages - Tổng @Model.TotalRecords công việc
                    </p>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Không có công việc nào phù hợp với điều kiện lọc.
                </div>
            }
        </div>
    </div>
</div>

    @* ==== MODAL XÁC NHẬN BẮT ĐẦU ==== *@
    <div class="modal fade" id="confirmBatDauModal" tabindex="-1" role="dialog" aria-labelledby="confirmBatDauModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="confirmBatDauModalLabel">
                        <i class="fas fa-play-circle"></i> Xác Nhận Bắt Đầu Công Việc
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc muốn <strong>bắt đầu</strong> công việc này?</p>
                    <div class="alert alert-info mb-0">
                        <strong>Mã phân công:</strong> <span id="batDauMaPhanCong"></span><br />
                        <strong>Phòng:</strong> <span id="batDauMaPhong"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-times"></i> Hủy
                    </button>
                    @using (Html.BeginForm("BatDau", "CongViec", FormMethod.Post, new { id = "formBatDau" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", "", new { id = "batDauPhanCongId" })
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check"></i> Xác Nhận
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ==== MODAL XÁC NHẬN HOÀN THÀNH ==== *@
    <div class="modal fade" id="confirmHoanThanhModal" tabindex="-1" role="dialog" aria-labelledby="confirmHoanThanhModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="confirmHoanThanhModalLabel">
                        <i class="fas fa-check-circle"></i> Xác Nhận Hoàn Thành Công Việc
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc muốn <strong>hoàn thành</strong> công việc này?</p>
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-info-circle"></i> Sau khi hoàn thành, phòng sẽ được cập nhật trạng thái thành <strong>"Trống"</strong>.
                    </div>
                    <div class="alert alert-info mt-2 mb-0">
                        <strong>Mã phân công:</strong> <span id="hoanThanhMaPhanCong"></span><br />
                        <strong>Phòng:</strong> <span id="hoanThanhMaPhong"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-times"></i> Hủy
                    </button>
                    @using (Html.BeginForm("HoanThanh", "CongViec", FormMethod.Post, new { id = "formHoanThanh" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", "", new { id = "hoanThanhPhanCongId" })
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-check"></i> Xác Nhận
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut('slow', function() {
                    $(this).remove();
                });
            }, 5000);

            // Modal Bắt Đầu
            $('#confirmBatDauModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var phanCongId = button.data('phancong-id');
                var phanCongMa = button.data('phancong-ma');
                var phongMa = button.data('phong-ma');
                
                var modal = $(this);
                modal.find('#batDauPhanCongId').val(phanCongId);
                modal.find('#batDauMaPhanCong').text(phanCongMa);
                modal.find('#batDauMaPhong').text(phongMa);
            });

            // Modal Hoàn Thành
            $('#confirmHoanThanhModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var phanCongId = button.data('phancong-id');
                var phanCongMa = button.data('phancong-ma');
                var phongMa = button.data('phong-ma');
                
                var modal = $(this);
                modal.find('#hoanThanhPhanCongId').val(phanCongId);
                modal.find('#hoanThanhMaPhanCong').text(phanCongMa);
                modal.find('#hoanThanhMaPhong').text(phongMa);
            });
        });
    </script>
}

